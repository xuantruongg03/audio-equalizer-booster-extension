{
    "manifest_version": 3,
    "name": "Zyno Audio Equalizer & Booster Pro",
    "version": "3.0.0",
    "description": "Studio 10-band equalizer, 800% volume booster, reverb, bass boost, spatial 7D audio, AI Auto-Genre and per-site profiles.",
    "author": "Zyno Ecosystem",
    "permissions": ["tabCapture", "offscreen", "storage", "activeTab", "tabs"],
    "host_permissions": [
        "http://*/*",
        "https://*/*"
    ],
    "action": {
        "default_popup": "popup/popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "32": "icons/icon32.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png",
            "256": "icons/icon256.png"
        },
        "default_title": "Zyno Audio Equalizer & Booster Pro v3.0"
    },
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png",
        "256": "icons/icon256.png"
    },
    "background": {
        "service_worker": "background/background.js",
        "type": "module"
    },
    "minimum_chrome_version": "116"
}
